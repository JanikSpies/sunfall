# Only used for prod (generated by CI from GitHub repo secrets/vars into
# admin_panel/.env, same as backend/.env). Dev sets all of this inline in
# docker-compose.dev.yml instead -- see the README.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Whatever origin the browser actually loads the admin from, e.g.
# https://sunfall.io -- without this, login POSTs 403 with "CSRF
# verification failed" (Django's Origin check rejects anything not listed
# here once a reverse proxy is involved). Comma-separate multiple origins.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# "Sign in with Django" for Grafana -- see docker-compose.yml's prod_grafana
# GF_AUTH_GENERIC_OAUTH_* (also needs GRAFANA_OAUTH_ENABLED=true,
# GRAFANA_ROOT_URL and GRAFANA_OAUTH_AUTH_URL set as GH vars once you know
# Grafana's real public URL). OAUTH_REDIRECT_URI must exactly match what
# Grafana computes: {GRAFANA_ROOT_URL}login/generic_oauth
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
